# 本地配置模板（不含真实密钥）
# 用法：把本文件复制为同目录下的 application-local.yml 并填入本地真实值；
#      application-local.yml 已被 .gitignore 忽略，不会进仓库。
# 也可以不用该文件，改为设置环境变量：
#      QUANTA_DB_USERNAME / QUANTA_DB_PASSWORD / QUANTA_DB_URL
#      QUANTA_CONFIG_AES_KEY（配置凭据加密密钥，Base64 编码的 32 字节）
#      QUANTA_MT5_BASE_URL（MT5 桥接服务地址，默认 http://127.0.0.1:8765）

spring:
  datasource:
    username: your_username
    password: your_password

quanta:
  security:
    # 生成方式（二选一）：
    #   openssl rand -base64 32
    #   [Convert]::ToBase64String((1..32 | % {Get-Random -Maximum 256}))
    aes-key: your_base64_aes_key_here